{
  // OPCIONAL — Cloudflare Workers, plan gratuito: frontend estático (dist/) + /api/ask determinística.
  // Sin IA, sin bindings pagos, sin secretos. La web también funciona como sitio estático puro.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prisa-insights-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
